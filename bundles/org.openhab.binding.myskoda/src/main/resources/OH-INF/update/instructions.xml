<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<update:update-descriptions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:update="https://openhab.org/schemas/update-description/v1.0.0"
	xsi:schemaLocation="https://openhab.org/schemas/update-description/v1.0.0 https://openhab.org/schemas/update-description-1.0.0.xsd">

	<thing-type uid="myskoda:vehicle">

		<instruction-set targetVersion="1">
			<add-channel id="plug-connection-state" groupIds="charging">
				<type>myskoda:plug-connection-state</type>
			</add-channel>
			<add-channel id="plug-lock-state" groupIds="charging">
				<type>myskoda:plug-lock-state</type>
			</add-channel>
		</instruction-set>

		<instruction-set targetVersion="2">
			<add-channel id="name" groupIds="chargingProfile">
				<type>myskoda:profile-name</type>
			</add-channel>
			<add-channel id="at-location" groupIds="chargingProfile">
				<type>myskoda:at-profile-location</type>
			</add-channel>
			<add-channel id="next-charging-time" groupIds="chargingProfile">
				<type>myskoda:next-charging-time</type>
			</add-channel>
			<add-channel id="target-state-of-charge" groupIds="chargingProfile">
				<type>myskoda:profile-target-state-of-charge</type>
			</add-channel>
			<add-channel id="max-charge-current" groupIds="chargingProfile">
				<type>myskoda:profile-max-charge-current</type>
			</add-channel>
			<add-channel id="auto-unlock-plug" groupIds="chargingProfile">
				<type>myskoda:profile-auto-unlock-plug</type>
			</add-channel>
			<add-channel id="min-state-of-charge-enabled" groupIds="chargingProfile">
				<type>myskoda:min-state-of-charge-enabled</type>
			</add-channel>
			<add-channel id="min-state-of-charge" groupIds="chargingProfile">
				<type>myskoda:min-state-of-charge</type>
			</add-channel>
			<add-channel id="last-updated" groupIds="chargingProfile">
				<type>myskoda:charging-profile-last-updated</type>
			</add-channel>
		</instruction-set>

		<instruction-set targetVersion="3">
			<add-channel id="timers" groupIds="chargingProfile">
				<type>myskoda:profile-timers</type>
			</add-channel>
			<add-channel id="preferred-charging-times" groupIds="chargingProfile">
				<type>myskoda:profile-preferred-charging-times</type>
			</add-channel>
		</instruction-set>

		<!-- refresh channels created by the 2026-08-31 version, whose tags and descriptions changed when they became writable -->
		<instruction-set targetVersion="4">
			<update-channel id="target-state-of-charge" groupIds="charging">
				<type>myskoda:target-state-of-charge</type>
			</update-channel>
			<update-channel id="preferred-charge-mode" groupIds="charging">
				<type>myskoda:preferred-charge-mode</type>
			</update-channel>
			<update-channel id="target-temperature" groupIds="climate">
				<type>myskoda:target-temperature</type>
			</update-channel>
			<update-channel id="without-external-power" groupIds="climate">
				<type>myskoda:without-external-power</type>
			</update-channel>
			<update-channel id="auxiliary-target-temperature" groupIds="auxiliaryHeating">
				<type>myskoda:target-temperature</type>
			</update-channel>
			<update-channel id="start-mode" groupIds="auxiliaryHeating">
				<type>myskoda:auxiliary-start-mode</type>
			</update-channel>
			<update-channel id="duration" groupIds="auxiliaryHeating">
				<type>myskoda:auxiliary-duration</type>
			</update-channel>
		</instruction-set>

	</thing-type>

</update:update-descriptions>
